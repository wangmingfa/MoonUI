import {
  "username/MoonUI/packages/moonui",
  "username/MoonUI/backends/native-common",
}

warnings = "-unused_package"

// MoonUI 的前台门（§47 的注记：Core 一行不 import 后端，wasm job 结构性钉住；
// 这份门面把真后端 import 进来，用户从此不 import 后端包、不构造后端结构、
// 不管 init 时序）。
//
// `T82`（2026-10-15）删 libui 收敛单后端之后，先前的装箱枚举 `AnyBackend` 与
// 单元枚举 `Backend` 整个失去存在理由（61 份转发全是单臂、`AnyBackend::of`
// 恒等）——门面缩成 `new_app()` 一个三步糖，返回 `App[NativeBackend]`。将来
// 若真长出第二个后端，再按枚举装箱的形状重新立门面（moonc v0.10.15 上对象
// 装箱各形状全部拒绝、枚举转发是保证可行的那条，经验记在 git log 里）。
//
// 整个包 native-only（同 backends/ 的门控形状）：它存在的意义就是真后端会话，
// wasm 侧没有内容。**没有测试文件**是有意的：它引用真后端的 extern，任何
// 测试二进制都会把 C 拉进链接，而 ubuntu 上没有 GUI 库可链——它的验证跟着
// 真后端的真窗口测试与示例壳走，core/wasm 门禁由 ci-packages.sh 显式排除。

options(
  targets: { "app.mbt": [ "native" ] },
)
