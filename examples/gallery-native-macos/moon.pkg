import {
  "username/MoonUI/packages/moonui",
  "username/MoonUI/backends/native-common",
  "username/MoonUI/examples/common",
}

pkgtype(kind: "executable")

// 组件画册跑在**原生 Cocoa 后端**上（设计文档 §51 的 Backend #2，macOS 半，FP2）。
// 和 ../gallery-native（libui-ng 后端）逐行同构，换掉的只有底下的 C：
// @native-common.NativeBackend 底下不经过 libui-ng，窗口、事件循环、控件全部
// 直写 AppKit（见 backends/native-macos/adapter_native.m）。MoonBit 侧一行不差，
// 这正是 §47 风险 6 要验证的形状——同一份画册代码，两个后端。
//
// 左栏是 macOS 设置那种"一行一项"的扁平菜单（MenuRow，选中高亮），点一项换右栏。
// 这是 FP2 要证明的方向：原生后端上画册的左栏不再是"一堆按钮"。
//
// 链接配置和 C 编译都不在 moon.pkg 里：仓库根的 prebuild-link.js 把
// backends/native-macos/adapter_native.m 现编成 .o，连同平台链接参数
// （-lobjc -framework Cocoa，**不**带 libui.a）一起挂到 ../native-common 上，
// 顺 import 传下来。相对路径按当前工作目录（仓库根）展开，moon 命令要在仓库根跑。
//
// 这个例子不进 CI：它要一只会点鼠标的手。真窗口链路在 CI 上的等价验证是
// backends/native-macos 的测试。

options(
  targets: { "main.mbt": [ "native" ] },
)
