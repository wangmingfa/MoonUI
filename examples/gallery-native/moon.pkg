import {
  "username/MoonUI/packages/moonui",
  "username/MoonUI/packages/moonui-app",
  "username/MoonUI/examples/common",
}

pkgtype(kind: "executable")

// 组件画册跑在**原生后端**上（设计文档 §51 的 Backend #2，2026-10-14 由
// gallery-native-macos / gallery-native-windows 两份平台壳合并而来，同 `T67`
// 那次合并的思路：prebuild-link.js 按宿主自己编 C——macOS 是
// backends/native-macos/adapter_native.m（直写 AppKit），Windows 是
// backends/native-windows/adapter_native.c（直写 Win32），MoonBit 侧没有平台
// 分叉，这正是 §47 要的形状。后端经前台门 packages/moonui-app 拿（`T82` 删
// libui 收敛单后端之后，前台门是 new_app() 一个三步糖）。
//
// 链接配置和 C 编译都不在 moon.pkg 里：prebuild-link.js 把平台那份 adapter
// 现编成 .o/.obj 挂到 ../native-common 上（Windows 半连 user32/comctl32 那排
// 系统库一起；mac 半的平台共享半 -lobjc/-framework Cocoa 自 2026-10-15 T80 起
// 挂 packages/moonui），各串都顺 import 传下来。相对路径按当前工作目录（仓库根）
// 展开，moon 命令要在仓库根跑。
//
// 这个例子不进 CI：它要一只会点鼠标的手。真窗口链路在 CI 上的等价验证是
// backends/native-macos 的测试（T6 起真跑）。

options(
  targets: { "main.mbt": [ "native" ] },
)
