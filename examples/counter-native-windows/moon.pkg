import {
  "username/MoonUI/packages/moonui",
  "username/MoonUI/backends/libui-common",
  "username/MoonUI/backends/libui-windows",
  "username/MoonUI/examples/common",
}

pkgtype(kind: "executable")

warnings = "-unused_package"

// 整个例子只在 native 下存在：main.mbt 要链接 libui-ng，wasm 路径上没有它。
// 包里没有别的 .mbt，所以 wasm 侧这个包是空的，靠 -unused_package 放行。
//
// macOS 那份对照物是 ../counter-native-macos，它换成 ../libui-macos，MoonBit 侧
// 一行不差——§47 风险 6 的"Core 一行不改接真后端"在这里是第二次兑现。
//
// 链接参数不写在这里：仓库根 prebuild-link.js（moon.mod 的
// `--moonbit-unstable-prebuild` 指过去）把 backends/libui-windows 的链接配置
// 注入构建图、顺 import 传进本包（TODO `T60`）。/LIBPATH 相对当前工作目录展开，
// 所以 moon 命令必须在仓库根跑。

options(
  targets: { "main.mbt": [ "native" ] },
)
