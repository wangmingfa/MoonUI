import {
  "username/MoonUI/packages/moonui",
  "username/MoonUI/backends/native-common",
  "username/MoonUI/examples/common",
}

pkgtype(kind: "executable")

// 组件画册跑在**原生 Win32 后端**上（设计文档 §51 的 Backend #2，Windows 半，
// T75/T77）。和 ../gallery-native（libui-ng 后端）逐行同构，换掉的只有底下的
// C：@native-common.NativeBackend 底下不经过 libui-ng，窗口、事件循环、控件
// 全部直写 Win32（见 backends/native-windows/adapter_native.c）。MoonBit 侧
// 一行不差，这正是 §47 风险 6 要验证的形状——同一份画册代码，两个后端。
//
// 左栏的 MenuRow 在这一侧是 BS_PUSHLIKE 的按钮（选中态走 BM 状态，T77）：
// Win32 的按钮没有"去边框左对齐"的现成入口，菜单感在原生 Cocoa 后端上才做足。
//
// 链接配置和 C 编译都不在 moon.pkg 里：仓库根的 prebuild-link.js 把
// backends/native-windows/adapter_native.c 现编成 .obj，连同平台链接参数
// （user32/comctl32 那排，**不带** libui.a）一起挂到 ../native-common 上，
// 顺 import 传下来。相对路径按当前工作目录（仓库根）展开，moon 命令要在仓库根跑。
//
// 这个例子不进 CI：它要一只会点鼠标的手。真窗口链路在 CI 上的等价验证是
// backends/native-windows 的测试。

options(
  targets: { "main.mbt": [ "native" ] },
)
