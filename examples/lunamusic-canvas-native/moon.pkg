import {
  "username/MoonUI/packages/moonui",
  "username/MoonUI/backends/canvas-macos",
  "username/MoonUI/examples/lunamusic-shell",
  "username/MoonUI/examples/lunamusic-host",
}

pkgtype(kind: "executable")

// lunamusic 自绘壳（§52.5 分期③，T98③d）：与 ../lunamusic-native 同一
// 棵 Core 树、同一份装配（在 ../lunamusic-shell），只把后端换成 CanvasBackend
// （Backend #3）——控件全部由画布配方绘制。T253 起不再直接 import
// @native-common：音频与帧钟都从 ../lunamusic-host 注入。包名锁死 -native
// 后缀（wasm 排除规则）；C 链接与 gallery-native 同一套 prebuild。
