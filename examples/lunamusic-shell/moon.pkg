import {
  "username/MoonUI/packages/moonui",
  "username/MoonUI/examples/lunamusic",
  "moonbitlang/core/env",
  "moonbitlang/async",
  "moonbitlang/async/http",
  "username/MoonUI/backends/native-common",
  "username/MoonUI/packages/platform-services",
}

warnings = "-unused_package"

// lunamusic 的双后端共享壳（§52.5 分期③，T98③d）：音频 ABI 适配
// （NativeAudioEngine，唯一碰 moonui_native_audio_* 的 MoonBit 代码）与
// 应用装配（菜单栏/曲库档/偏好档/进度心跳/拖入）都在这里，原生壳
// （../lunamusic-native）与自绘壳（../lunamusic-canvas-native）只差
// 一个后端的构造。壳是库不是可执行——`launch` 收一个现成的 App。
//
// shell.mbt 逐文件门控 native-only（音频 extern 在 wasm 上没有宿主）；
// wasm 门里这个包是空的，与 backends/native-common 同款形状。
// online_lyrics.mbt 同理：moonbitlang/async 的 http 只有 native 实现。

options(
  targets: {
    "shell.mbt": [ "native" ],
    "online_lyrics.mbt": [ "native" ],
    // T173 规模实测的 bench（native_time_ms 只有 native 有）。
    "bench_wbtest.mbt": [ "native", "llvm" ],
    // 返回码 → AudioError 的码表判据（T38 的错误码那一半）：跟着 shell.mbt
    // 走，纯 MoonBit 算术、不调真 C，两侧返回码不同所以不许混进共享测试。
    "shell_wbtest.mbt": [ "native", "llvm" ],
  },
)
