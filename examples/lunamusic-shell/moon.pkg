import {
  "username/MoonUI/packages/moonui",
  "username/MoonUI/examples/lunamusic",
  "moonbitlang/core/env",
  "moonbitlang/async",
  "moonbitlang/async/http",
  "username/MoonUI/packages/platform-services",
}

// T173 规模实测的 bench 时钟（`T253`）：壳不再 import @native-common，
// `native_time_ms` 换成 `@bench.monotonic_clock`（微秒 Double）。按 test-only
// import 挂，别让 `moon check` 把主包这边的依赖报成 unused。
import {
  "moonbitlang/core/bench",
} for "wbtest"

warnings = "-unused_package"

// lunamusic 的双后端共享壳（§52.5 分期③，T98③d）：装配（菜单栏/曲库档/
// 偏好档/进度心跳/拖入）在这里，原生壳（../lunamusic-native）与自绘壳
// （../lunamusic-canvas-native）只差一个后端、一份 `@lunamusic.AppHost` 与一只
// `AudioEngine` 的构造。`T253` 起本包不再 import 任何后端：音频适配与宿主能力
// 住在 native 边缘包 ../lunamusic-host。
//
// shell.mbt 逐文件门控 native-only（宿主能力与 async 的 http 只有 native 有）；
// wasm 门里这个包是空的，与 backends/native-common 同款形状。
// online_lyrics.mbt 同理：moonbitlang/async 的 http 只有 native 实现。

options(
  targets: {
    "shell.mbt": [ "native" ],
    "online_lyrics.mbt": [ "native" ],
    // T173 规模实测的 bench（@bench 的单调钟只有 native/llvm 上测才准）。
    "bench_wbtest.mbt": [ "native", "llvm" ],
  },
)
