// Traits
pub(open) trait AudioEngine {
  fn load(Self, String) -> Track raise AudioError
  fn play(Self) -> Unit raise AudioError
  fn pause(Self) -> Unit
  fn unpause(Self) -> Unit raise AudioError
  fn stop(Self) -> Unit
  fn seek(Self, Int64) -> Unit
  fn position(Self) -> Int64
  fn duration(Self) -> Int64
  fn set_volume(Self, Int32) -> Unit
  fn is_playing(Self) -> Bool
  fn on_finished(Self, () -> Unit) -> Unit
  fn level(Self, Int32) -> Int32
  fn eq_band_count(Self) -> Int32
  fn eq_apply(Self, Array[Int32], Bool) -> Unit
}
