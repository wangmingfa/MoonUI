  "龂龅龇龃龆龄出龈啮咬龊龉龋腭龌龙厐庞䶮龚龛龟"

///|
/// 一次性建好的反查表（`@lazy` 让首次取词才付这份钱）。
let t2s_map : @lazy.Lazy[Map[Char, Char]] = @lazy.Lazy(fn() {
  let m : Map[Char, Char] = Map([])
  for i = 0; i < t2s_from.length(); i = i + 1 {
    let a = t2s_from[i].to_int().to_char().unwrap()
    let b = t2s_to[i].to_int().to_char().unwrap()
    m[a] = b
  }
  m
})

///|
/// 把一段繁体中文转成简体。非中文字符原样穿过；一个字都没变时直接返回入参
/// （省一次整串重建——绝大多数调用是"本来就是简体"或纯 ASCII）。
pub fn to_simplified(s : String) -> String {
  let m = t2s_map.force()
  let out : Array[String] = []
  let mut changed = false
  for c in s {
    match m.get(c) {
      Some(v) => {
        out.push(v.to_string())
        changed = true
      }
      None => out.push(c.to_string())
    }
  }
  if !changed {
    return s
  }
  out.join("")
}

///|
/// 这段文字是不是**本来就是简体**（或压根不是中文）。判据：整段里没有任何
/// 一个表内的繁体字。只用来给测试与调试一个可读的答案——取词逻辑不靠它，
/// 因为"服务器只有繁体"已经说明了结论。
pub fn is_simplified(s : String) -> Bool {
  let m = t2s_map.force()
  for c in s {
    if m.contains(c) {
      return false
    }
  }
  true
}
