// lunamusic 应用本体（DESIGN.md C-05）：**库包**，进 core / wasm 门禁。
// 不许 import backends/native-common——音频 ABI 的 extern 全在 native 壳里，
// 本体只面向 AudioEngine trait（engine.mbt）编程；测试全走 MockAudioEngine。
//
// 落盘与目录行走（`T197`）已收进框架 `@moonui.Fs`：本包不再自己声明 libc
// 符号，也不再有按目标分叉的 IO 文件；wasm 上的缺席仍由框架显式报
// Unsupported（与 window_state_file_wasm.mbt 同一套口径）。
import {
  "moonbitlang/core/json",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/lazy",
  // 随机播放洗牌（T167）：`Rand::shuffle` 是现成的 Fisher-Yates，
  // 生产走平台熵源、测试换固定种子。
  "moonbitlang/core/random",
  "username/MoonUI/packages/moonui",
  // 歌曲信息写回（C-13）：vendored 的 moontag 源码，见其 README 的出处与致谢。
  "username/MoonUI/examples/lunamusic-tag",
}

options(
  targets: {
    // `T197` 起落盘与目录行走收进了框架（`@moonui.Fs`）：本包不再有按目标
    // 分叉的 IO 文件，只剩这条"要真探盘"的判据仍然只能 native 跑。
    "lyrics_native_wbtest.mbt": [ "native", "llvm" ],
  },
)

warnings = "-implicit_impl_as_method"
