// Playground 跑在**原生后端**上（gallery-native 同款）：prebuild-link.js 按宿主
// 现编平台 C adapter（macOS 直写 AppKit / Windows 直写 Win32），链接配置挂
// backends/native-common 顺 import 传下来；MoonBit 侧没有平台分叉。这个壳
// 要真人关窗口才退出，不进 CI（ci-packages.sh 按 -native 后缀排除）。
import {
  "username/MoonUI/packages/moonui",
  "username/MoonUI/packages/moonui-app",
}

pkgtype(kind: "executable")

options(
  targets: { "main.mbt": [ "native" ] },
)
