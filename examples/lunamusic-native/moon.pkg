import {
  "username/MoonUI/packages/moonui-app",
  "username/MoonUI/examples/lunamusic-shell",
  "username/MoonUI/examples/lunamusic-host",
}

pkgtype(kind: "executable")

// lunamusic 真窗壳（原生后端半，Backend #2）：装配在 ../lunamusic-shell，
// 音频与宿主能力在 ../lunamusic-host（T253 后共享壳不再 import 后端），这里
// 只构造原生后端 + App 并注入三样东西。包名锁死 -native 后缀
// （ci-packages.sh 的 wasm 排除规则）；C 链接经 host → native-common 的
// prebuild 传下来。

options(
  targets: { "main.mbt": [ "native" ] },
)
