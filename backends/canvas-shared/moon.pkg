import {
  "username/MoonUI/packages/moonui",
  "username/MoonUI/backends/native-common",
  "username/MoonUI/backends/native-abi",
  "username/MoonUI/backends/canvas-common",
  "username/MoonUI/packages/platform-services",
}

warnings = "-unused_package"

// 自绘后端的共享半（设计文档 §52，Backend #3）：把 canvas-common 的绘制
// 配方接到 moonui_canvas_* 的平台上。画笔（CanvasPainter，含 Scale 的
// 逻辑→物理换算，§30）`T101` 起搬到 native-common——它包的 FFI 本来就住
// 那边，原生后端的自定义绘制面也要用同一份；本包只留记账与帧循环。
//
// 零 C：位图/字形的平台活全在平台 adapter（../native-macos/adapter_native.m、
// ../native-linux/adapter_native_gtk.c，`T392` 起自绘后端在 Linux 上也跑），
// 经 ../native-common 的 extern 声明走 FFI；本包整包 native-only（import
// native-common 的 extern 门控决定了它上不了 wasm）。
//
// 平台壳：../canvas-macos 与 ../canvas-linux 只是 `pub type CanvasBackend =
// @canvas-shared.CanvasBackend` 的别名壳（`T392`）——后端选择是编译期的
// （`App[B : Backend]` 静态分发），应用 import 哪个壳就用哪个名，实现只此一份。
//
// 门控口径（`T392`）：canvas-macos 当年只把 backend/frame/impl/ime/mouse 钉在
// native，**漏了 geo.mbt 与 keys.mbt**——它们也调 @native-common 的 extern，
// wasm 上会炸（只是整包被 CI 排除才没咬）。共享半把**全部** .mbt 钉进
// targets，别照抄那个漏。

options(
  targets: {
    "backend.mbt": [ "native" ],
    "frame.mbt": [ "native" ],
    "impl.mbt": [ "native" ],
    "geo.mbt": [ "native" ],
    "keys.mbt": [ "native" ],
    "ime.mbt": [ "native" ],
    "mouse.mbt": [ "native" ],
    // 真跑测试只在 native 下存在（native-macos 同款门控）
    "canvas_shared_test.mbt": [ "native" ],
    "canvas_backend_test.mbt": [ "native" ],
  },
)
