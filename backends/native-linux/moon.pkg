import {
  "username/MoonUI/packages/moonui",
  "username/MoonUI/backends/native-common",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/encoding/utf16",
}

warnings = "-unused_package"

// 原生 GTK4 后端包（设计文档 §51 的 Backend #2，Linux 半，T235）：只剩直写
// GTK4 的 C 源文件（adapter_native_gtk.c，prebuild 现编）和真窗口测试，
// MoonBit 侧一行不写——共享实现在 ../native-common（ffi.mbt 的 FFI 声明 +
// backend.mbt 的 87 个 Backend impl 与 6 个 PlatformServices impl）。§47 的
// "平台分叉不在 MoonBit 层"就靠这个分工：本目录一份 C，中间那份 MoonBit
// 谁也不改。
//
// 链接配置和 C 编译都不在 moon.pkg 里：仓库根的 prebuild-link.js 把本包的
// adapter_native_gtk.c 现编成 .o，连同 GTK4/Cairo 的链接参数（由 pkg-config
// 现取）一起挂到 ../native-common 上，顺 import 传下来——本包的测试二进制
// import 了 native-common，所以自动拿到同一份 adapter 与链接参数。配置挂
// native-common 而不是本包，是为了避开"测试二进制住在配置所在包里、adapter
// 被链两遍"的重复符号（libui 时代同一套形状，T82 删；见 ../native-common/
// moon.pkg 的说明）。相对路径按当前工作目录展开，所以 moon 命令要在仓库根跑。
//
// P3–P6-5（2026-11-09）状态：adapter_native_gtk.c 由
// scripts/gen-native-linux-gtk.js 从 adapter.h 生成——**窗口生命周期 / 事件循环 /
// 键盘 / 鼠标 / 手势 / 收尾**这几组 ABI 已落地真实 GTK4（`GtkWindow` +
// `GtkEventController*` + `GtkGesture*`，尺寸变化走 `main_step` 里的轮询），
// **画布 24 条**（P4）已是真实现（cairo；手写的 canvas_gtk.inc），**控件挂载层
// 18 条**（P6-1）也已落地（手写的 widgets_gtk.inc：窗口内容容器
// `GtkOverlay`→`GtkFixed`、Panel/Custom 两种控件、attach/摆放/层叠、命中反查），
// **剪贴板 2 条**（P6-2，手写的 clipboard_gtk.inc）也已落地——那一小片有个特别
// 的坑：GTK4 的剪贴板读是**异步**的（read_text_async + `_finish`），而 ABI 是同步
// 返回，所以在 C 里开临时 GMainLoop 泵到回调为止（上限 250ms，超时按"没有文本"
// 处理）；写走 gdk_clipboard_set_content 而不是 gdk_clipboard_set_text（后者返
// void，拿不到 0/-2 的分别）。**对话框与文件面板 8 条**（P6-3，手写的
// dialogs_gtk.inc）也已落地——那一小片卡在版本上：最低 4.6 就只有 GtkMessageDialog
// + GtkFileChooserNative 可用（GtkAlertDialog / GtkFileDialog 要 4.10），而 GTK4
// 早已没有同步的 gtk_dialog_run（4.10 移除），连 GtkNativeDialog 的 run/response
// 也一并没了，所以同样靠临时 GMainLoop 等 "response"。**菜单栏与上下文菜单 7 条**
// （P6-4a，手写的 menus_gtk.inc）也已落地：`GtkPopoverMenuBar` + `GMenuModel` +
// `GSimpleActionGroup`，点击走 `g_action_group_activate_action`（与用户点菜单项同
// 一条派发）；分隔线用 section 表达（GTK4 的分隔线没有自己的 widget）、radio 显示
// 勾（GTK 的圆点要求"同一动作+不同 target"，而 Core 只推"勾没勾"）、快捷键走
// GMenu 的 accel 属性。装了菜单栏的窗口内容从 GtkOverlay 换成 `GtkBox[bar,
// overlay]`，客户区尺寸在请求值上补一行菜单栏（`gtk_widget_measure` 实测 24）——
// 与 Win32 半"SetMenu 之后客户区矮一行"同一个问题。**系统外观与控件样式 2 条**
// （P6-4b，手写的 theme_gtk.inc）也已落地：`system_theme` 优先读 4.20+ 的
// `gtk-interface-color-scheme`（枚举常量 Since 4.20，运行时按 GEnum 名字查，
// 不硬编码值），DEFAULT / 4.6 上属性不存在时回落到 `prefer-dark` +
// `gtk-theme-name` 大小写归一后判 "dark"；`widget_set_style` 按 kind 分消费面，
// 每 widget 一条 `.moonui-w-<hex>` 规则、一只 `GtkCssProvider` 挂到 display，
// 生命周期用 `g_object_set_data_full` 绑在 widget 上。CSS 拼串与深色判定是不碰
// GTK 的纯逻辑（生成物 prelude），假头闸第 10 组能真跑。**无障碍 4 条**
// （P6-4c，手写的 a11y_gtk.inc）也已落地：`set_widget_accessibility` 把 Core 的
// role 序号映射成 GTK 枚举**名字**（运行时查 GEnum 值，不硬编码数值），按
// (ptr,len) 复制 UTF-8 文本下发 LABEL/DESCRIPTION（空串 reset 清旧值），state
// 位包只消费 bits2-3 的 CHECKED —— bit0/bit1 是 GTK 按 widget 活值自己算的
// DISABLED/HIDDEN，注记快照就是 T58 定案要避开的谎报；两条偏好读数分别取
// `gtk-enable-animations` 的反面与 4.20+ `gtk-interface-contrast` 的 MORE
// （4.6 回落两个主题名里的 HighContrast 线索）；`custom_set_focusable` 只对
// kind 18 的 Custom 面生效。纯逻辑放 prelude，假头闸第 11 组能真跑。**控件叶子 8 条**
// （P6-5，手写的 leaves_gtk.inc；widget_new 在 widgets_gtk.inc 里从 2 种 kind 扩到
// 10 种）也已落地：文案按 (ptr,len) 复制后分派到 GtkLabel / GtkButton /
// GtkCheckButton / GtkEditable，占位与文本两条独立通道，勾选走 active，三条回调
// 经信号 trampoline 派发；程序化改值用登记表上的 inhibit 吞掉 changed/toggled 回声
// （探针实测 gtk_editable_set_text 会发 2 条 changed、set_active 会发 toggled）。
// kind → 构造形态只有 prelude 一张表，假头闸第 12 组逐字对拍。十一份手写实现都被生成物
// #include 进**同一个翻译单元**，所以不新增 prebuild 编译单元；`IMPL_FILES` 的
// 顺序就是 include 顺序（widgets 在前，canvas 的 attach_window 要用它的容器）。**音频 34 条是"显式
// 缺席"**（P5）：不写 GStreamer/ALSA（`T237` 裁决③「音频不在框架承诺范围」），
// 但也不当中性桩——
// 中性桩 return 0 在 audio_load 上就是"歌装上了"的谎报，所以按 adapter.h 的口径
// 逐条给 -3 / 哨兵值（码表与 Windows 半的音频段一致，判据在
// scripts/mock-gtk-selftest.c 第 6 组）。其余 91 个符号仍是中性桩，成片的是
// 19 WebView（要嵌 WebKitGTK，按「未必做」留着）。P6-5b 的 14 MenuRow / 15
// Scroll 两个叶子、自绘面点击（custom_on_clicked）与焦点链三条已落地，P6-5c 的
// 六个专属构造族（Slider / Spinbox / Progress / ComboBox / MultilineEntry /
// RadioButtons / DatePicker，共七种）也已落地（第十一片 widgets2_gtk.inc）。
// 生成器里 REAL 表加一条即可（重跑幂等）；整片手写的进 IMPL_FILES，
// "本平台不做但要如实报"的进 ABSENT 表。本机 macOS 的验证分四层（都在
// scripts/，由 test-local.sh 串起来）：
//   ① mock-gtk-check.sh —— 假头语法 + 360 项纯逻辑判据（不需要 GTK4；编译时必须
//      定义 MOONUI_MOCK_GTK，否则手写实现会真去 include <cairo.h>）。P6-1 起
//      这一层还带一棵**假 widget 树**，所以控件登记表 / 命中反查 / 层叠序号
//      这三块的判据是**真跑**的（第 7 组）；第 8 组是对话框 response → 返回码的
//      纯映射（"只有 YES 算同意"那条口径）；第 9 组是菜单树的字节解析与 dump
//      文本（好树与九种坏树，好树那根期望串与像素闸逐字对拍）；第 10 组 36 项是
//      P6-4b 的 permille 小数、kind 消费面、字重档位与两代深色属性的优先级，
//      CSS 原串逐字对拍（GTK 会把任何合法 CSS 都照收，真跑闸看不出写歪的通道序）；
//      第 11 组 50 项是 P6-4c 的 role → GTK 枚举名字、checked 位包、按长度复制
//      的 CJK/内嵌 NUL 文本、两条偏好读数的每个分支（总数 153 → 203）；第 12 组
//      55 项是 P6-5 的 kind → 构造形态表、文案通道号、形态名字逐字对拍与
//      (ptr,len) 复制的字节数/内嵌 NUL（总数 203 → 258）
//   ② gtk4-sysroot-check.sh —— **真 GTK4 头**下编译（私有 sysroot，由
//      gtk4-sysroot-fetch.sh 从 brew bottle 解出，不动系统）。这道抓的是
//      "API 名字/签名用错"：P3 第一跑就抓出 5 处 GTK3 遗留。另带一道最低版本闸
//      （GDK_VERSION_MAX_ALLOWED=4.6），防止写到 Ubuntu 22.04 上编不过的新 API。
//   ③ canvas-pixel-check.sh —— **真链接 + 真跑**：画布逐条摸像素（P4），P6-1 起
//      还跑控件层结构（造 / 挂 / 摆 / 层叠 / 摘挂 / 画布与控件共存），P6-2 起跑
//      剪贴板写读往返（会临时占用系统剪贴板，每条自己备份/恢复），P6-3 起跑消息框
//      真应答（桌面上会闪一下）与文件面板（要先有 GSettings schema，缺了就 SKIP），
//      P6-4a 起跑菜单栏（dump 读的是**真正挂上去的** GMenuModel）与上下文菜单，
//      P6-4b 起跑主题（真 GtkSettings 两代读口、GTK 解析器规范化后的 CSS 文本，
//      以及往实现那只 provider 追加 color 规则后读 GtkLabel 的**样式级联**——
//      只有这一条能证 provider 真的挂到了 display），P6-4c 起跑无障碍（读 GTK
//      自己的 test AT context：role / LABEL / DESCRIPTION / CHECKED；两条反向 A/B
//      钉住 DISABLED 没被重排快照覆盖）、两条系统偏好真 GtkSettings A/B 与
//      自绘面 focusable；P6-5 起跑控件叶子（十种 kind 读 G_OBJECT_TYPE_NAME、
//      Separator 方向、文案/占位/勾选读 GTK getter、回调真派发与程序化改值不回声、
//      真 GtkLabel 上的 fg/font/weight 读级联颜色与 Pango 字号字重）；
//      无显示器下 gtk_init_check 也成立，所以那几条是对真 GtkFixed / 真
//      GdkClipboard / 真 GtkMessageDialog / 真 GtkPopoverMenuBar 真跑。①② 只能证"自洽"，证不了"画出来
//      是对的颜色、对的位置"、"层叠顺序真的换了"、"写进剪贴板的读回来还是那段"、
//      "点了『是』之后返回的真是 1"。
//   ④ 真链接 / xvfb 真窗 —— 本机 mac 上「真链接 + 真跑」已经成立（③那条，59 条；
//      cairo 在 mac 与 Linux 是同一份软件光栅器）；ubuntu 上由 CI 的
//      linux-backend-link job 跑同一份三道闸（P7，xvfb 包住）。P8 起 ③ 里有一条
//      **真窗判据**（t_p8_real_window）：present 出去、有界泵到映射，再量窗口分配、
//      上屏前后 widget_size 的两档、零内缩 Label 的物理像素往返、以及 GTK 自己的
//      gtk_widget_child_focus 正反各走一步。**Tab 键真派发与滚轮单位仍未验**：
//      GTK4 公开头里没有 GdkEvent 构造函数，进程内合成不了事件，只能靠外部输入
//      （X 下 xdotool）在 CI 的 xvfb 里量。
//   另：scripts/abi-symbols.sh 从 P8 起也核这一份（真 GTK4 头编成 .o 取符号表），
//   它第一天就抓出 moonui_canvas_create_with_backend 在这侧没有定义（现在补上了）。
// 改 ABI 的正确姿势是改 adapter.h 再重跑生成器；直接手改生成物会在下一次重跑时
// 丢失，手改请落到 scripts/gen-native-linux-gtk.js 的 REAL 表里（整片手写的落
// 进 widgets_gtk.inc / leaves_gtk.inc / canvas_gtk.inc / clipboard_gtk.inc /
// dialogs_gtk.inc / menus_gtk.inc / theme_gtk.inc / a11y_gtk.inc 这类 IMPL_FILES，"本平台不做但要如实报"的落进 ABSENT）。

options(
  targets: {
    // 真窗口的测试只在 native 下存在：native_test.mbt 要链接 GTK4，wasm 路径
    // 上它没有，而包里没有别的 .mbt，所以 wasm 侧这个包是空的，靠
    // -unused_package 放行。
    "native_test.mbt": [ "native" ],
  },
)
