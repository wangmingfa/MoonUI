import {
  "username/MoonUI/packages/moonui",
  "username/MoonUI/backends/canvas-common",
  "username/MoonUI/backends/native-abi",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/buffer",
  "username/MoonUI/packages/platform-services",
}

warnings = "-unused_package"

// 原生后端的共享 MoonBit 层（设计文档 §51 的 Backend #2）：FFI 声明（ffi.mbt）+
// `@moonui.Backend` 的实现（backend.mbt），底下不经过任何中间 GUI 库——C 在
// ../native-macos（adapter_native.m，直写 AppKit）与 ../native-windows
// （adapter_native.c，直写 Win32），平台分叉只到 C 为止（§47）。
//
// 本包**没有 native-stub、也没有 link**：C 编译和链接配置都不在 moon.pkg 里，
// 仓库根的 prebuild-link.js 把平台那份 adapter 现编成 .o/.obj 挂到
// **本包**上，顺 import 传给下游（Windows 半带 user32/comctl32 那排系统库，
// mac 半带 -lobjc 与 Cocoa/AVFoundation/Metal 等 framework——**都在这一份里**）。
//
// 口径订正（2026-11-07）：`T80` 当年确实把 -lobjc/-framework Cocoa 那半劈开
// 挂到 packages/moonui（怕两份 common 都吃到重复配置），`T82` 收敛单后端后
// 已不再需要。当前 prebuild-link.js:344-359 **只吐一份 link_configs**、
// package 恒为本包；本文件旧版注释里"仍挂 packages/moonui"那类说法是史注，
// 别照着改配置。
// 为什么 adapter 挂本包而不是平台包：测试二进制住在平台包里，配置若挂在那一侧
// 会被 moon 对"包库 + 测试可执行"各应用一次、把 adapter 链两遍撞重复符号——
// 这个分工是 libui 时代（配置挂 libui-common、C 与测试住 libui-macos，`T82` 删）
// 验证过的，本侧照抄同一套形状。
//
// 历史上本包曾与 ../libui-common 并存、互不 import（import 对方会顺带把那份 C 经
// prebuild 链进来，和 adapter 撞符号），一个可执行包只能 import 其中一个后端；
// `T82` 删 libui 后全仓只剩本包一个后端。§51 的"libui-ng 只是第一个 Backend"
// 就落在这个分工上：Core 一行不改，换后端只换 import。
//
// 依赖 canvas-common 是 `T101`（自定义绘制面）起的：那份 Painter trait 是
// "把绘制清单重放给一支画笔"的共同语言，`CanvasPainter`（painter.mbt，原住
// canvas-macos）是它在 `moonui_canvas_*` 上的实现。canvas-common 只 import
// Core、零 FFI，所以这个方向不会成环（canvas-macos 两个都 import，仍在上游）。
//
// 整个包都是 native-only：ffi.mbt 里的 extern "c" 在 wasm 上没有宿主，所以逐文件
// 门控（targets）。本包没有测试文件：真窗口的测试跟着 C 走，在 ../native-macos
// 与 ../native-windows（native_test.mbt），用 `@native-common.` 引用这里的公共实现。
//
// `T230` / `T236`（2026-11-08）补的口径：**本包加不了无头判据，不等于判定表
// 没判据**。散在 ffi.mbt / canvas.mbt / backend.mbt 里的十张纯判定表（`T230`
// 四张：Int64 拆二元组、widget kind 编码、返回码 → UiError、measure_text 拆包；
// `T236` 六条：三档 / 四态返回码表、窗口态位包、图像探针位包、宿主码表、
// 无障碍状态位包）已搬到 ../native-abi（零 C、零 FFI、进 wasm 门），那里有逐格
// 判据；这里只留一行委托，共 18 处。新的 ABI 编码 / 拆包 / 返回码翻译一律先
// 写进 native-abi 并配判据，别再直接塞进 extern 封装或 impl 的身体里。
// 委托层本身仍是 native-only、没有无头判据——这是 targets 门控的技术边界，
// 靠 `moon check --deny-warn` 与逐字审查兜住。

options(
  targets: {
    "ffi.mbt": [ "native" ],
    "backend.mbt": [ "native" ],
    "canvas.mbt": [ "native" ],
    "painter.mbt": [ "native" ],
  },
)
