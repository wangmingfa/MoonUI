import {
  "username/MoonUI/packages/moonui",
  "username/MoonUI/backends/libui-common",
}

// 这个包本体没有 .mbt 实现（共享实现全在 ../libui-common），下面的 import
// 全是给黑盒测试 windows_test.mbt 用的：`moon check` 编译包本体时看不见测试文件，
// 会把它们全报成 unused_package 假阳性，所以这里压掉这一种警告。

warnings = "-unused_package"

// Windows 后端包：只有 Win32 那份 C（adapter.c + libui-ng 的 ui.h / ui_windows.h）和
// 它自己的 35 条真窗口测试（`backend_wbtest.mbt` 29 条 + `ffi_wbtest.mbt` 6 条）。
// MoonBit 实现一行都不在这里——那是 ../libui-common 那份，
// macOS 跑的也是同一份。§47 的"平台分叉不在 MoonBit 层"就靠这个分工。
//
// 链接配置和 C 编译都不在 moon.pkg 里：仓库根 prebuild-link.js（moon.mod 的
// `--moonbit-unstable-prebuild` 指过去）把宿主那份 adapter 现编成 .obj，连同
// 平台链接参数一起挂到 ../libui-common 上，顺 import 传下来——本包的测试
// 二进制 import 了 libui-common，自动拿到同一份 adapter 与链接参数（TODO `T60`；
// 原先本包自带 native-stub 自己编一份，删它换"全链路只有一份 C 产物"的说明见
// libui-macos 那份 moon.pkg）。/LIBPATH 相对当前
// 工作目录展开，所以 moon 命令必须在仓库根跑；产物 libui.a 由
// scripts/build-libui.ps1 从固定提交现编。
//
// 注入的那串是 MSVC 写法，而 link_configs 的传播只按输出后端（native / js / wasm）
// 分档、没有宿主系统这一维，所以本包在 macOS / Linux 上连不上：那边 moon 驱动 clang，
// 它把 / 开头的参数当文件路径（实测 no such file or directory: '/utf-8'）。因此本包
// 只在 Windows 上被链接，各宿主的清单写在 scripts/test-local.sh 与 scripts/ci-packages.sh。
//
// adapter.c 文件头带 BOM：MSVC 认 UTF-8 源码靠它（prebuild 现编时 cl 走 /utf-8），
// 警告等级从 /W3 回到默认 /W1，adapter.c 不靠警告等级找问题。
// adapter.c 里的 `#if defined(_WIN32)` 从"必须"降级成"防线"：
// 留着的场合是有人在这台 mac 上点名本包，clang 照样编它，得到一份空 TU 加一条
// `libtool: the table of contents is empty`，而不是撞 windows.h。
//
// 两份测试文件同属本包（whitebox），互相看得见：登记表与清场写在 backend_wbtest.mbt，
// ffi_wbtest.mbt 直接调它。注意 MoonBit 是**按文件**产测试二进制的，所以两张表在两个
// 二进制里各有一份副本，跨文件共享的是名字不是状态（本机实测：一条测试往包级 Array
// 里 push，另一个文件的测试读到的还是空）。

options(
  targets: {
    "backend_wbtest.mbt": [ "native" ],
    "ffi_wbtest.mbt": [ "native" ],
  },
)
