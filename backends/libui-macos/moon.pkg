import {
  "username/MoonUI/packages/moonui",
  "username/MoonUI/backends/libui",
  // 只有 macos_test.mbt 用它：那份测试自带一条按文案找控件的脚手架 FFI，需要
  // String 到 UTF-8 字节的编码。测试包继承本包的依赖，所以写在这里。
  "moonbitlang/core/encoding/utf8",
}

warnings = "-unused_package"

// macOS 后端包：共享的 MoonBit 实现（ffi.mbt + backend.mbt）在 ../libui，本目录
// 只有 Cocoa 的 C 侧和它的链接配置。§47 的"平台分叉不在 MoonBit 层"就靠这个分工。
//
// ../libui 的 native-stub 会顺着 import 一起编（examples/hello-native/moon.pkg:17
// 记的就是这件事），所以那份 adapter.c 必须能在 clang 下编译成空 TU——见它的
// #if defined(_WIN32)。link 只按输出后端分档、没有宿主系统这一维，所以 Windows 的
// link 配置留在 ../libui/moon.pkg 里不动，本包写 macOS 这份。
//
// cc-link-flags 里的相对路径按当前工作目录展开，所以 moon 命令必须在仓库根跑；
// libui.a 由 scripts/build-libui.sh 从固定提交现编。

options(
  "native-stub": [ "adapter_macos.m" ],
  targets: {
    // 真窗口的测试只在 native 下存在：macos_test.mbt 要链接 libui-ng，wasm 路径上
    // 没有它，而包里没有别的 .mbt，所以 wasm 侧这个包是空的，靠 -unused_package 放行。
    "macos_test.mbt": [ "native" ],
  },
  link: {
    "native": {
      "cc-link-flags": "-lobjc -framework Cocoa third-party/libui/lib/libui.a",
    },
  },
)
