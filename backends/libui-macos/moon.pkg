import {
  "username/MoonUI/packages/moonui",
  "username/MoonUI/backends/libui-common",
  // 只有 macos_test.mbt 用它：那份测试自带一条按文案找控件的脚手架 FFI，需要
  // String 到 UTF-8 字节的编码。测试包继承本包的依赖，所以写在这里。
  "moonbitlang/core/encoding/utf8",
}

// 这个包本体没有 .mbt 实现（共享实现全在 ../libui-common），下面三个 import
// 全是给黑盒测试 macos_test.mbt 用的：`moon check` 编译包本体时看不见测试文件，
// 会把三条全报成 unused_package 假阳性，所以这里压掉这一种警告。

warnings = "-unused_package"

// macOS 后端包：只剩 Cocoa 那份 C 的源文件（adapter_macos.m，现由 prebuild
// 现编，见下）和真窗口测试，MoonBit 侧一行不写——共享实现在 ../libui-common
// （ffi.mbt 的 81 条 FFI 声明 + backend.mbt 的 44 个 trait 实现），Windows 跑的
// 也是同一份。§47 的"平台分叉不在 MoonBit 层"就靠这个分工：两个目录各一份 C，
// 中间那份 MoonBit 谁也不改。
//
// 链接配置和 C 编译都不在 moon.pkg 里：仓库根的 prebuild-link.js（moon.mod 的
// `--moonbit-unstable-prebuild` 指过去）把宿主那份 adapter 现编成 .o，连同
// 平台链接参数一起挂到 ../libui-common 上，顺 import 传下来——本包的测试
// 二进制 import 了 libui-common，所以自动拿到同一份 adapter 与链接参数。
// （原先本包自带 "native-stub": [ "adapter_macos.m" ] 自己编一份，那时
// 链接配置只能挂到单独的挂点包上，否则测试二进制会把 adapter 链两遍、
// 撞重复符号；连 native-stub 一起交给 prebuild 后，整条链路上只剩
// 一份 C 产物、一份配置，libui-native 挂点包随之删除。）相对路径按当前
// 工作目录展开，所以 moon 命令要在仓库根跑；libui.a 由
// scripts/build-libui.sh 从固定提交现编。

options(
  targets: {
    // 真窗口的测试只在 native 下存在：macos_test.mbt 要链接 libui-ng，wasm 路径上
    // 没有它，而包里没有别的 .mbt，所以 wasm 侧这个包是空的，靠 -unused_package 放行。
    "macos_test.mbt": [ "native" ],
    "ffi_wbtest.mbt": [ "native" ],
  },
)
