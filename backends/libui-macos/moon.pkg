import {
  "username/MoonUI/packages/moonui",
  "username/MoonUI/backends/libui-common",
  // 只有 macos_test.mbt 用它：那份测试自带一条按文案找控件的脚手架 FFI，需要
  // String 到 UTF-8 字节的编码。测试包继承本包的依赖，所以写在这里。
  "moonbitlang/core/encoding/utf8",
}

warnings = "-unused_package"

// macOS 后端包：只有 Cocoa 那份 C（adapter_macos.m）和它的链接配置，MoonBit 侧
// 一行不写——共享实现在 ../libui-common（ffi.mbt 的 81 条 FFI 声明 + backend.mbt 的
// 44 个 trait 实现），Windows 跑的也是同一份。§47 的"平台分叉不在 MoonBit 层"
// 就靠这个分工：两个目录各一份 C，各一套 link，中间那份 MoonBit 谁也不改。
//
// ../libui-common 没有 native-stub，所以 mac 这条路径上不会编到 Windows 那份
// adapter.c（改名之前会：那时它和共享实现同目录，native-stub 顺着 import 传下来，
// mac 上每次构建多印一句 libtool: the table of contents is empty）。
//
// link 只按输出后端分档、没有宿主系统这一维，所以 Windows 的 link 配置写在
// ../libui-windows/moon.pkg 里，本包写 macOS 这份；两边互不被对方的编译器读到。
//
// cc-link-flags 里的相对路径按当前工作目录展开，所以 moon 命令必须在仓库根跑；
// libui.a 由 scripts/build-libui.sh 从固定提交现编。
//
// adapter_macos.m 里的中文注释要 clang 认 UTF-8：mac 上这是默认，不需要额外声明，
// 所以本包不写 stub-cc-flags（那份 flags 在 Windows 侧是 cl 的 /utf-8，写法不通用）。

options(
  "native-stub": [ "adapter_macos.m" ],
  targets: {
    // 真窗口的测试只在 native 下存在：macos_test.mbt 要链接 libui-ng，wasm 路径上
    // 没有它，而包里没有别的 .mbt，所以 wasm 侧这个包是空的，靠 -unused_package 放行。
    "macos_test.mbt": [ "native" ],
  },
  link: {
    "native": {
      "cc-link-flags": "-lobjc -framework Cocoa third-party/libui/lib/libui.a",
    },
  },
)
