import {
  "username/MoonUI/backends/canvas-shared",
}

warnings = "-unused_package"

// 自绘后端的 Windows 壳（`T391`）：实现只一份（../canvas-shared），本壳零逻辑。
// 后端选择是编译期的（`App[B : Backend]` 静态分发），应用 import 本包就用
// `@canvas-windows.CanvasBackend`——别名是透明的，构造器 / 关联函数 /
// `@moonui.Backend` 与 `@platform-services.PlatformServices` 两个 impl 都随
// 底层类型可见。
//
// 零 C：平台活全在 ../native-windows/adapter_native.c（`moonui_canvas_*` 那批
// 已在 Windows 侧落地），经 ../native-common 的 extern 声明走 FFI；整包
// native-only（别名指向 native-only 的类型）。
//
// Windows 真窗/真画布验证要 Windows 机（canvas-macos 的判据口径可复用）；
// 本壳在 Linux 上只能编译检查（`moon check --target native`），不能真跑。

options(
  targets: { "main.mbt": [ "native" ] },
)
